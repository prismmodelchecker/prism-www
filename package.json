{
  "name": "prism-www",
  "version": "1.0.0",
  "private": true,
  "description": "The PRISM website (www.prismmodelchecker.org), built with Eleventy",
  "type": "module",
  "scripts": {
    "build": "rm -rf _site && node scripts/sync-manual.js && eleventy --quiet && pagefind --site _site",
    "serve": "eleventy --serve --port 8080",
    "export-bib": "node scripts/export-bib.js",
    "sync-manual": "node scripts/sync-manual.js",
    "manual-offline": "node scripts/manual-offline.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "markdown-it-container": "4.0.0",
    "markdown-it-multimd-table": "4.2.3",
    "pagefind": "1.3.0"
  }
}
