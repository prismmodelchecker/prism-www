<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.title %}{{ title }} – {% endif %}{{ site.title }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="/css/site.css?v={{ build.version }}">
{{ headExtra | safe }}
{%- if pageStyle %}<style>{{ pageStyle | safe }}</style>{% endif %}
<script src="/js/site.js?v={{ build.version }}" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>

<header class="site-header">
	<div class="site-header__top"><div class="site-header__inner">
		<a class="brand" href="/">
			<img src="/images/logo/p128.png" alt="" width="54" height="54">
			<span class="brand__name">PRISM</span>
		</a>
		<span class="brand__tagline">{{ site.tagline | replace(" ", "<br>", 1) | safe }}</span>
		<form class="site-search" role="search" action="/search/" method="get">
			<label for="site-search-q" class="visually-hidden">Search the PRISM site</label>
			<input id="site-search-q" name="q" type="search" placeholder="Search">
			<button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></button>
		</form>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
	</div></div>
	<nav id="site-nav" class="site-nav" aria-label="Main">
		<ul>
		{%- for item in site.nav %}
			<li><a href="{{ item.url }}"{% if item.id == section %} aria-current="true"{% endif %}>{{ item.title }}</a></li>
		{%- endfor %}
			<li class="site-nav__github"><a href="https://github.com/prismmodelchecker" title="PRISM on GitHub"><svg viewBox="0 0 16 16" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg><span class="site-nav__github-label">GitHub</span><span class="visually-hidden"> (PRISM on GitHub)</span></a></li>
		</ul>
	</nav>
</header>

{%- set sectionNav = site.nav | sectionMenu(section) %}

<div class="page{% if sectionNav or isManual or newsSidebar %} page--with-nav{% endif %}{% if isManual %} page--manual{% endif %}{% if newsSidebar %} page--home{% endif %}">
	{%- if isManual %}
	{% include "partials/manual-nav.njk" %}
	{%- elif sectionNav %}
	<nav class="local-nav" aria-label="{{ sectionNav.title }}">
		<h2 class="local-nav__title"><a href="{{ sectionNav.url }}">{{ sectionNav.title }}</a></h2>
		<div class="local-nav__details">
		{%- set current = sectionNav.children | menuCurrent(page.url, listUrl) %}
		{%- set subNav = (sectionNav.children | menuItem(current)).children %}
		<ul>
		{%- for child in sectionNav.children %}
			<li><a href="{{ child.url }}"{% if child.url == current %} aria-current="{{ 'page' if child.url == page.url else 'true' }}"{% endif %}>{{ child.title }}{% if child.url.startsWith("http") %}<span class="ext" aria-hidden="true">↗</span>{% endif %}</a>
			{%- if child.children and child.url == current %}
			<ul class="local-nav__sub">
			{%- for sub in child.children %}
				<li><a href="{{ sub.url }}"{% if sub.url == page.url %} aria-current="page"{% endif %}>{{ sub.title }}</a></li>
			{%- endfor %}
			</ul>
			{%- endif %}</li>
		{%- endfor %}
		</ul>
		</div>
	</nav>
	{%- elif newsSidebar %}
	<nav class="local-nav" aria-label="Latest news">
		<h2 class="local-nav__title"><a href="/news/">Latest news</a></h2>
		<div class="local-nav__details">
		<div class="news-panel">
		<ul class="news news--striped">
		{%- for item in news | limit(3) %}
			<li><time datetime="{{ item.date }}">{{ item.date | monthYear }}</time> {{ item.html | safe }}</li>
		{%- endfor %}
		</ul>
		<p><a href="/news/">All news</a></p>
		</div>
		</div>
	</nav>
	{%- endif %}
	<main id="main" class="content"{% if searchExclude != "true" %} data-pagefind-body{% endif %}>
		{%- if section %}<span hidden data-pagefind-filter="Section">{{ (site.nav | sectionMenu(section, true)).title }}</span>{% endif %}
		{%- if not isManual and breadcrumb != false %}{% set crumbs = page.url | breadcrumbs(parent, collections.all) %}
		{%- if crumbs.length %}
		<p class="breadcrumb" data-pagefind-ignore>{% for c in crumbs %}<a href="{{ c.url }}">{{ c.title }}</a> › {% endfor %}</p>
		{%- endif %}{% endif %}
		{{ content | safe }}
		{%- if subNav %}{% set pn = subNav | prevNext(page.url) %}{% if pn.prev or pn.next %}
		<nav class="pager" aria-label="Previous and next page" data-pagefind-ignore>
			{%- if pn.prev %}<a class="pager__prev" href="{{ pn.prev.url }}" rel="prev"><span>Previous</span> {{ pn.prev.title }}</a>{% endif %}
			{%- if pn.next %}<a class="pager__next" href="{{ pn.next.url }}" rel="next"><span>Next</span> {{ pn.next.title }}</a>{% endif %}
		</nav>
		{%- endif %}{% endif %}
	</main>
</div>

<footer class="site-footer">
	<p>PRISM is free and open source, released under the GNU General Public License.
	Site hosted at the Department of Computer Science, University of Oxford.</p>
</footer>
</body>
</html>
