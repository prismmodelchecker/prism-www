mdp

const int n; // cells in E-W direction
const int m; // cells in N-S direction

//     ------------------> i
//  | | 1,1 | 2,1 | 3,1 |
//  |  -----------------
//  | | 1,2 | 2,2 | 3,2 |
//  |  -----------------
//  | | 1,3 | 2,3 | 3,3 |
//  |  -----------------
//  v
//  j

module robot
	i : [1..n]; // E-W coordinate
	j : [1..m]; // N-S coordinate

	[move] i=n -> (i'=n);
	[move] i<n -> (i'=i+1);

	[move] i=1 -> (i'=1);
	[move] i>1 -> (i'=i-1);

	[move] j=1 -> (j'=1);
	[mobe] j>1 -> (j'=j-1);

	[move] j=m -> (j'=m);
	[move] j<m -> (j'=j+1);

	[move] true -> true;
endmodule