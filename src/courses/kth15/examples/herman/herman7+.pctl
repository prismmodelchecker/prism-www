// stable states - where only one process has the same value as the process to its left
label "stable" = num_tokens=1;

// from the initial state, a stable state is reached with probability 1
P>=1 [ F "stable" ]

// from the initial state, what is the probability of
// reaching a stable state within 10 steps
P=? [ F<=10 "stable" ]

// what is the expected number of steps required to reach a stable state?
R=? [ F "stable" ]
