	/* lemmas for proving invariant 6.3 */
	forall (i in PROC) for(v = 1; v <= 2; v = v + 1) forall (j in PROC) {
		inv30[i][v][j] : assert G ( ( minus1_agree[i][v] & fill_agree[i][v] & (fill_maxr[i]=round[i]) & value[i]=v & pc[j]=INITIAL & round[i]+1=round[j]) -> count[i]<=j );
