---
layout: layouts/base.njk
section: publ
pagination:
  data: bib.items
  size: 1
  alias: item
permalink: "/bibitem/{{ item.key }}/"
parent: /publications/references/
listUrl: /publications/references/
fileIcons: { pdf: pdf, ps: ps, "ps.gz": ps, bib: tex }
fileNames: { pdf: PDF, ps: PostScript, "ps.gz": PostScript, bib: BibTeX }
---
<article class="bib-item">
{%- if item.year %}<span hidden data-pagefind-filter="Year">{{ item.year }}</span>{% endif %}
<span hidden data-pagefind-filter="Type">{{ bib.types | typeName(item.type) }}</span>
<h1>{{ item | bibTitle }}</h1>

<p class="bib-cite">{{ item | citation({ link: false }) | safe }}</p>

<dl>
{%- if item.files.length %}
<dt>Downloads</dt>
<dd class="bib-downloads">{% for f in item.files %}<a href="{{ f.url }}"><img src="/images/{{ fileIcons[f.ext] or "pdf" }}.png" alt="" width="16" height="16">{{ fileNames[f.ext] or f.ext }}{% if f.size %} <small>{{ f.size }}</small>{% endif %}</a>{% endfor %}</dd>
{%- endif %}
{%- set itemNotes = item | bibNotes %}
{%- if itemNotes.length %}
<dt>Notes</dt>
{%- for n in itemNotes %}<dd>{{ n | safe }}</dd>{% endfor %}
{%- endif %}
{%- if item.url %}
<dt>Available from</dt>
<dd><a href="{{ item.url }}">{{ item.url }}</a></dd>
{%- endif %}
<dt>Search for this paper</dt>
<dd>{% for l in item | bibSearchLinks %}<a href="{{ l.url }}">{{ l.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</dd>
</dl>

{%- if item.abstract %}
<section class="bib-abstract" aria-labelledby="abstract-heading">
<h2 id="abstract-heading">Abstract</h2>
{{ item.abstract | safe }}
</section>
{%- endif %}
</article>
