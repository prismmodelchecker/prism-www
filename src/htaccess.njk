---
permalink: /.htaccess
eleventyExcludeFromCollections: true
---
# Generated by the site build (src/htaccess.njk, from src/_lib/legacy.js): old URLs go to their new pages.

RewriteEngine on

# Security advisory
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
RewriteRule .* - [F]

# Old bibliography item pages: bibitem.php?key=K -> /bibitem/K/
RewriteCond %{QUERY_STRING} (^|&)key=([A-Za-z0-9+_-]+)
RewriteRule ^bibitem\.php$ /bibitem/%2/? [R=301,L]

# Old viewer for example files: casestudies/prismcode.php?name=x -> the file viewer
RewriteCond %{QUERY_STRING} (^|&)name=([A-Za-z0-9_.]+)
RewriteRule ^casestudies/prismcode\.php$ /view/?f=/casestudies/examples/%2 [R=301,L]

# Old publication search, which kept the search term in "search"
RewriteCond %{QUERY_STRING} (^|&)search=([^&]*)
RewriteRule ^publ-search\.php$ /publications/bibliography/?search=%2 [R=301,NE,L]

# Old publication lists sorted another way: bib.php?sort=type -> /publications/bibliography/by-type/
# (any ?search=... is kept, and the new page picks it up)
{%- for from in ["bib.php", "bib-ext.php", "publications.php"] %}
RewriteCond %{QUERY_STRING} (^|&)sort=(type|title|subject)(&|$)
RewriteRule ^{{ from | regexPath | safe }}$ {{ legacy.pageUrls[from] }}by-%2/ [R=301,L]
{%- endfor %}

# Pages whose URL changed
{%- for from, to in legacy.pageUrls %}
RewriteRule ^{{ from | regexPath | safe }}$ {{ to }} [R=301,L]
{%- endfor %}
{%- for from, to in legacy.oldPaths %}
RewriteRule ^{{ from | regexPath | safe }}$ {{ to }} [R=301,L]
{%- endfor %}

# Old releases and third-party downloads moved into the downloads folder
RewriteRule ^dl-old/(.*)$ /dl/old/$1 [R=301,L]
RewriteRule ^other/(.*)$ /dl/other/$1 [R=301,L]
RewriteRule ^courses/aims(2425|2526|2627)/(prism-4\.8\.1\.dev-.*\.tar\.gz)$ /dl/$2 [R=301,L]

# Developer pages moved to GitHub
RewriteRule ^(wiki|manual/Developers)(/.*)?$ {{ legacy.githubWiki }} [R=301,L]

# Manual: renamed pages, old section and contents pages, and the old upload folder
# (NE: targets can have an anchor, which must reach the browser as it is)
{%- for from, to in legacy.manual %}
RewriteRule ^manual/{{ from | regexPath | safe }}/?$ {{ to }} [R=301,NE,L]
{%- endfor %}
RewriteRule ^manual/uploads/(.*)$ /manual/files/$1 [R=301,L]

# "Printable version" pages of model and properties files (x.nm.php, x.nm.frag.php, x.nm.html)
# -> the file viewer; of other example files -> the files themselves
RewriteRule ^(.+\.(prism|nm|pm|sm|props|pctl|csl|smg|pp))(\.frag)?\.(php|html)$ /view/?f=/$1 [R=301,L]
RewriteRule ^(.*/examples/.+)\.php$ /$1 [R=301,L]

# Every other page: x.php -> /x/, dir/index.php -> /dir/ (the site has no PHP)
# (in the folders of files, other views x.y.php -> x.y, and pages x.php -> x.html)
RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L]
RewriteRule ^((files|subm)/.+\.\w+)\.php$ /$1 [R=301,L]
RewriteRule ^((files|subm)/.+)\.php$ /$1.html [R=301,L]
RewriteRule ^(.+)\.php$ /$1/ [R=301,L]
