<h1>Search</h1>
<div id="search"></div>
<noscript><p>Search needs JavaScript. You can also search with
<a href="https://www.google.com/search?q=site%3Aprismmodelchecker.org">Google</a>.</p></noscript>
<script>
window.addEventListener("DOMContentLoaded", () => {
	// pageLength: long pages are penalised less than by default (0.75), so short paper pages don't crowd out
	// case studies, tutorials and the manual (papers are also given less weight, in bibitem.njk)
	const ui = new PagefindUI({ element: "#search", showSubResults: true, showImages: false, showEmptyFilters: false,
		ranking: { pageLength: 0.3 } });
	const params = new URLSearchParams(location.search);
	// ?section=Manual (from the manual's search box) pre-selects that filter
	if (params.get("section")) ui.triggerFilters({ Section: [params.get("section")] });
	if (params.get("q")) ui.triggerSearch(params.get("q"));
});
</script>
